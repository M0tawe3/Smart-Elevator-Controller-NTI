int main(void)
{
  UART_Init(9600);
  TIMER0_Init();
  SPI_InitMaster(0u);

  uint8 rec;
  while (1)
  {
    rec = HC165_Read(1u, 4u);

    UART_SendByte(rec);

    TIMER0_DelayMS(1000);
  }
  return 0;
}
